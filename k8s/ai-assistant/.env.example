IMAGE=haikelilham/ai-assistant:latest

# Supported values: sumopod, google, openai
AI_PROVIDER=sumopod
AI_MODEL=

# Fill only the key for the selected provider. Empty values are still written
# to the Kubernetes Secret so the shared Deployment manifest stays portable.
SUMOPOD_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Optional. Use 0812... or an international number such as 62812...
WHATSAPP_RECIPIENT=

# Scheduled curated pipeline. jobs.db persists on the existing PVC.
JOB_ALERT_PIPELINE_ENABLED=true
GLINTS_ENABLED=true
JOB_ALERT_DB_PATH=/root/.picoclaw/jobs.db
JOB_ALERT_MAX_QUERIES=5
JOB_ALERT_AI_BATCH_SIZE=5
JOB_ALERT_MIN_MATCH_SCORE=70

# Optional scheduled job-alert email. Gmail requires an App Password.
MAIL_MAILER=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_FROM=
MAIL_TO=
